{
    "comments": {
        // EXPRESS tail remark (ISO 10303-11:2004, 7.1.6.2)
        "lineComment": "--",
        // EXPRESS embedded remark (7.1.6.1); a description block after END_SCHEMA; is written the same way
        "blockComment": [ "(*", "*)" ]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        // The "(" before the "*" has already been closed with ")": only the "*" is added, which gives "(* *)".
        { "open": "(*", "close": "*", "notIn": ["string"] },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ]
}
