{
  "name": "express",
  "scopeName": "source.express",
  "fileTypes": [
    ".exp"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.express",
      "match": "(?i)\\b(END_SUBTYPE_CONSTRAINT|SUBTYPE_CONSTRAINT|GENERIC_ENTITY|END_PROCEDURE|END_CONSTANT|END_FUNCTION|VALUE_UNIQUE|ENUMERATION|END_ENTITY|END_REPEAT|END_SCHEMA|EXTENSIBLE|TOTAL_OVER|AGGREGATE|END_ALIAS|END_LOCAL|OTHERWISE|PROCEDURE|REFERENCE|SUPERTYPE|ABSTRACT|BASED_ON|CONSTANT|END_CASE|END_RULE|END_TYPE|FUNCTION|OPTIONAL|VALUE_IN|BLENGTH|BOOLEAN|CONST_E|GENERIC|HIBOUND|HIINDEX|INTEGER|INVERSE|LOBOUND|LOGICAL|LOINDEX|RENAMED|ROLESOF|SUBTYPE|UNKNOWN|BINARY|DERIVE|END_IF|ENTITY|ESCAPE|EXISTS|FORMAT|INSERT|LENGTH|NUMBER|REMOVE|REPEAT|RETURN|SCHEMA|SELECT|SIZEOF|STRING|TYPEOF|UNIQUE|USEDIN|ALIAS|ANDOR|ARRAY|BEGIN|FALSE|FIXED|LOCAL|LOG10|ONEOF|QUERY|UNTIL|VALUE|WHERE|WHILE|ACOS|ASIN|ATAN|CASE|ELSE|FROM|LIKE|LIST|LOG2|REAL|RULE|SELF|SKIP|SQRT|THEN|TRUE|TYPE|WITH|ABS|AND|BAG|COS|DIV|END|EXP|FOR|LOG|MOD|NOT|NVL|ODD|SET|SIN|TAN|USE|VAR|XOR|AS|BY|IF|IN|OF|OR|PI|TO)\\b"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "--",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.express"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.express"
        },
        {
          "name": "comment.block.express",
          "begin": "\\(\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.express"
            }
          },
          "end": "\\*\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.express"
            }
          }
        }
      ]
    }
  }
}
