# Re-include runtime externals (esbuild marked these external in
# src/extension/main.cjs and src/extension/workers/plurimath-worker.cjs;
# they MUST be present in node_modules at runtime).
!node_modules/@plurimath/
!node_modules/@plurimath/**
!node_modules/mathjax/
!node_modules/mathjax/**
# Trim mathjax: we only use input/asciimath + output/svg + core/loader/startup.
# Drop the prebuilt combo bundles (we don't load them) and SRE locale data
# (only English used; speech-rule output isn't surfaced in our viewers).
