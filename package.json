{
  "name": "easyexpress",
  "displayName": "easyEXPRESS",
  "description": "EXPRESS language support for Visual Studio Code",
  "homepage": "https://github.com/TRThurman/easy-express-mirror",
  "bugs": {
    "url": "https://github.com/TRThurman/easy-express-mirror/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TRThurman/easy-express-mirror.git"
  },
  "preview": true,
  "publisher": "TRThurman",
  "license": "MIT",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base",
    "esbuild-base": "tsc --noEmit && npm run lint && node esbuild.mjs --minify",
    "build": "tsc -b tsconfig.json && node esbuild.mjs",
    "clean": "rm -rf out dist src/language/generated && echo '🧹 Clean complete'",
    "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\"",
    "lint": "eslint src",
    "langium:generate": "langium generate",
    "langium:watch": "langium generate --watch",
    "test": "vitest --reporter=verbose",
    "coverage": "vitest --coverage",
    "prebuild": "langium generate",
    "pretest": "langium generate",
    "rebuild": "npm run clean && npm ci && langium generate && npm run build && npm test",
    "_comment": "deep clean removes lockfile; must use `npm install` to regenerate it",
    "clean:deep": "rm -rf node_modules out dist src/language/generated package-lock.json && echo '🧹 Deep clean complete'",
    "rebuild:full": "npm run clean:deep && npm install && langium generate && npm run build && npm test",
    "release-pre": "release-it --preRelease --ci",
    "release": "release-it --ci"
  },
  "dependencies": {
    "@asciidoctor/core": "3.0.4",
    "@plurimath/plurimath": "0.2.2",
    "chalk": "~5.6.2",
    "commander": "~15.0.0",
    "dompurify": "3.4.15",
    "mathjax": "4.1.3",
    "uuid": "^14.0.2",
    "vscode-languageclient": "~10.1.1",
    "vscode-languageserver": "~9.0.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^24.7.1",
    "@types/vscode": "~1.137.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.2",
    "eslint": "~9.39",
    "happy-dom": "20.14.3",
    "jsdom": "26.1.0",
    "langium": "^4.4.0",
    "langium-cli": "^4.4.0",
    "release-it": "^20.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.70",
    "vitest": "^3.2.7"
  },
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "express.buildWorkspace",
        "title": "Build EXPRESS workspace",
        "category": "easyEXPRESS"
      },
      {
        "command": "express.buildGraph",
        "title": "Generate type graphs",
        "category": "easyEXPRESS"
      },
      {
        "command": "express.showDescription",
        "title": "Show Description",
        "category": "easyEXPRESS"
      },
      {
        "command": "express.showExpressG",
        "title": "Show EXPRESS-G Diagram",
        "category": "easyEXPRESS"
      },
      {
        "command": "express.openMathPlayground",
        "title": "Open AsciiMath Playground",
        "category": "easyEXPRESS"
      },
      {
        "command": "express.sendSelectionToMathPlayground",
        "title": "Send Selection to AsciiMath Playground",
        "category": "easyEXPRESS"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "express.showDescription",
          "when": "editorLangId == express",
          "group": "navigation@1"
        },
        {
          "command": "express.showExpressG",
          "when": "editorLangId == express",
          "group": "navigation@2"
        },
        {
          "command": "express.sendSelectionToMathPlayground",
          "when": "editorLangId == express && editorHasSelection",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "easyEXPRESS language server",
      "properties": {
        "express.useOptimizedConfiguration": {
          "type": "boolean",
          "default": true,
          "description": "Use STEP optimized configuration and ignore files and folders not required for development."
        },
        "express.excludedFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "dvlp",
            "sys",
            "nav",
            "ap233_system_engineering_and_design",
            "css",
            "doc",
            "dtd",
            "help",
            "images",
            "publication",
            "utils",
            "xsl",
            "basic",
            "library",
            "resource_docs",
            "business_object_models"
          ],
          "description": "Exclude folders that contain one of these keywords in their name."
        },
        "express.excludedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lf",
            "concatenated"
          ],
          "description": "Exclude files that contain one of these keywords in their name."
        }
      }
    },
    "languages": [
      {
        "id": "express",
        "aliases": [
          "EXPRESS",
          "ISO 10303-11"
        ],
        "extensions": [
          ".exp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "express",
        "scopeName": "source.express",
        "path": "./syntaxes/express-p11.manual.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "express",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:**/*.exp"
  ],
  "main": "./out/extension/main.js",
  "bin": {
    "express-cli": "./bin/cli.js"
  }
}
