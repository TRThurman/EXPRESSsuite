{
  "name": "easyEXPRESS",
  "displayName": "easyEXPRESS",
  "description": "EXPRESS language support for Visual Studio Code",
  "homepage": "https://github.com/usnistgov/easyexpress-public/",
  "bugs": {
    "url": "https://github.com/usnistgov/easyexpress-public/issues"
  },
  "preview": true,
  "publisher": "usnistgov",
  "license": "See License.txt",
  "icon": "nist_logo.png",
  "version": "0.2.5",
  "engines": {
    "vscode": "^1.67.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "easyEXPRESS language server",
      "properties": {
        "express-p-11.useOptimizedConfiguration": {
          "type": "boolean",
          "default": true,
          "description": "Use STEP optimized configuration and ignore files and folders not required for development."
        },
        "express-p-11.excludedFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "dvlp",
            "sys",
            "nav",
            "ap233_system_engineering_and_design",
            "css",
            "doc",
            "dtd",
            "help",
            "images",
            "publication",
            "utils",
            "xsl",
            "basic",
            "library",
            "resource_docs",
            "business_object_models"
          ],
          "description": "Exclude folders that contain one of these keywords in their name."
        },
        "express-p-11.excludedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lf",
            "concatenated"
          ],
          "description": "Exclude files that contain one of these keywords in their name."
        }
      }
    },
    "languages": [
      {
        "id": "express-p-11",
        "aliases": [
          "express-p11",
          "express-p-11"
        ],
        "extensions": [
          ".exp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "express-p-11",
        "scopeName": "source.express-p-11",
        "path": "./syntaxes/express-p-11.manual.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "express-p-11",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:**/*.exp"
  ],
  "files": [
    "bin",
    "out",
    "src"
  ],
  "bin": {
    "express-p-11-cli": "./bin/cli"
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "tsc --noEmit && npm run lint && node esbuild.mjs --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "build": "tsc -b tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch",
    "lint": "eslint src --ext ts",
    "langium:generate": "langium generate",
    "langium:watch": "langium generate --watch",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "chalk": "~4.1.2",
    "chevrotain": "~10.4.2",
    "commander": "~10.0.0",
    "langium": "^1.2.0",
    "vscode-languageclient": "~8.0.2",
    "vscode-languageserver": "~8.0.2",
    "vscode-uri": "~3.0.7"
  },
  "devDependencies": {
    "@types/node": "~16.18.11",
    "@types/vscode": "~1.67.0",
    "@typescript-eslint/eslint-plugin": "~5.51.0",
    "@typescript-eslint/parser": "~5.51.0",
    "@vitest/coverage-v8": "^0.34.6",
    "esbuild": "^0.18.17",
    "eslint": "~8.33.0",
    "langium-cli": "^1.2.0",
    "typescript": "~4.9.5",
    "vitest": "^0.34.6"
  }
}
