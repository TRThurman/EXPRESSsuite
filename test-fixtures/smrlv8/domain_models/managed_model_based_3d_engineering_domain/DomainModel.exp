ENTITY CableOccurrenceTerminal
	SUBTYPE OF(OccurrenceTerminal);
	SELF\OccurrenceTerminal.AssociatedTransportFeature : WireIdentification;
	SELF\ShapeElement.ElementOf : CableOccurrenceTerminalLocationGroup;
END_ENTITY;

ENTITY CableOccurrenceTerminalLocationGroup
	SUBTYPE OF(OccurrenceTerminal);
	SELF\OccurrenceShapeFeature.ElementOf : CableOccurrence;
END_ENTITY;

ENTITY Cartesian11
	SUBTYPE OF(DetailedGeometricModelItem);
	Placement : AxisPlacement;
END_ENTITY;

ENTITY CartesianPoint
	SUBTYPE OF(Point);
	Coordinates : LIST[2:3] OF LengthMeasure;
END_ENTITY;

ENTITY CartesianTransformation;
	RotationMatrix : LIST[2:3] OF LIST[2:3] OF REAL;
	Scale : OPTIONAL REAL;
	TranslationVector : LIST[2:3] OF REAL;
WHERE
WR1: SIZEOF( QUERY(xi <* RotationMatrix |  SIZEOF( QUERY(xj <* xi | (-1.0 > xj) OR (xj > 1.0))) > 0)) = 0;
WR2: Scale > 0.0;
WR3: SIZEOF(TranslationVector) = SIZEOF(RotationMatrix);
END_ENTITY;

ENTITY CentreOfMass
	SUBTYPE OF(ShapeDependentProperty);
	CentrePoint : CartesianPoint;
	SELF\ShapeDependentProperty.DefinedIn : GeometricCoordinateSpace;
END_ENTITY;

