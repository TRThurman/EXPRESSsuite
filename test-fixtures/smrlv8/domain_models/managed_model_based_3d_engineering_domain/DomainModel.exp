	SUPERTYPE OF (ExpandedUncertainty)
	SUBTYPE OF(UncertaintyQualifier);
	UncertaintyValue : REAL;
END_ENTITY;

ENTITY State
	SUPERTYPE OF (ONEOF(StateObserved, StatePredicted));
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
END_ENTITY;

ENTITY StateAssignment;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : OPTIONAL ClassSelect;
	AssignedState : State;
	AssignedTo : StateAssignmentSelect;
END_ENTITY;

ENTITY StateCauseEffect
	SUBTYPE OF(StateRelationship);
END_ENTITY;

ENTITY StateComposition
	SUBTYPE OF(StateRelationship);
END_ENTITY;

ENTITY StateDefinition;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Definition : ProxyItemSelect;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
END_ENTITY;

ENTITY StateDefinitionAssignment;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : OPTIONAL ClassSelect;
	AssignedStateDefinition : StateDefinition;
	AssignedTo : StateDefinitionAssignmentSelect;
END_ENTITY;

ENTITY StateDefinitionCauseEffect
	SUBTYPE OF(StateDefinitionRelationship);
END_ENTITY;

ENTITY StateDefinitionComposition
	SUBTYPE OF(StateDefinitionRelationship);
END_ENTITY;

ENTITY StateDefinitionConfirmedAssignment
	SUBTYPE OF(StateDefinitionStateAssignment);
	SELF\StateDefinitionStateAssignment.AssignedTo : StateObserved;
END_ENTITY;

ENTITY StateDefinitionHypothesisAssignment
	SUBTYPE OF(StateDefinitionStateAssignment);
	SELF\StateDefinitionStateAssignment.AssignedTo : StateObserved;
END_ENTITY;

ENTITY StateDefinitionPredictedAssignment
	SUBTYPE OF(StateDefinitionStateAssignment);
	SELF\StateDefinitionStateAssignment.AssignedTo : StatePredicted;
END_ENTITY;

ENTITY StateDefinitionRelationship
	SUPERTYPE OF (ONEOF(StateDefinitionCauseEffect, StateDefinitionComposition, StateDefinitionTransition));
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : OPTIONAL ClassSelect;
	Relating : StateDefinition;
	Related : StateDefinition;
END_ENTITY;

ENTITY StateDefinitionStateAssignment
	SUPERTYPE OF (ONEOF(StateDefinitionConfirmedAssignment, StateDefinitionHypothesisAssignment, StateDefinitionPredictedAssignment));
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : OPTIONAL ClassSelect;
	AssignedStateDefinition : StateDefinition;
	AssignedTo : State;
END_ENTITY;

ENTITY StateDefinitionStateAssignmentRelationship
	SUPERTYPE OF (StateHypothesisToConfirmationRelationship);
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : OPTIONAL ClassSelect;
	Relating : StateDefinitionStateAssignment;
	Related : StateDefinitionStateAssignment;
END_ENTITY;

ENTITY StateDefinitionTransition
	SUBTYPE OF(StateDefinitionRelationship);
DERIVE
	EndState : StateDefinition := SELF\StateDefinitionRelationship.Relating;
	StartState : StateDefinition := SELF\StateDefinitionRelationship.Related;
END_ENTITY;

ENTITY StateHypothesisToConfirmationRelationship
	SUBTYPE OF(StateDefinitionStateAssignmentRelationship);
	SELF\StateDefinitionStateAssignmentRelationship.Relating : StateDefinitionConfirmedAssignment;
	SELF\StateDefinitionStateAssignmentRelationship.Related : StateDefinitionHypothesisAssignment;
DERIVE
	ConfirmedState : StateDefinitionConfirmedAssignment := SELF\StateDefinitionStateAssignmentRelationship.Relating;
	HypothesizedState : StateDefinitionHypothesisAssignment := SELF\StateDefinitionStateAssignmentRelationship.Related;
END_ENTITY;

ENTITY StateObserved
	SUBTYPE OF(State);
END_ENTITY;

ENTITY StatePredicted
	SUBTYPE OF(State);
END_ENTITY;

ENTITY StatePredictedToObserved
	SUBTYPE OF(StateRelationship);
	SELF\StateRelationship.Relating : StatePredicted;
	SELF\StateRelationship.Related : StateObserved;
END_ENTITY;

ENTITY StateRelationship
	SUPERTYPE OF (ONEOF(StateCauseEffect, StateComposition, StatePredictedToObserved, StateTransition));
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : OPTIONAL ClassSelect;
	Relating : State;
	Related : State;
END_ENTITY;

ENTITY StateTransition
	SUBTYPE OF(StateRelationship);
DERIVE
	EndState : State := SELF\StateRelationship.Relating;
	StartState : State := SELF\StateRelationship.Related;
END_ENTITY;

ENTITY StockMaterial;
	Id : IdentifierSelect;
	Name : DescriptorSelect;
	Description : OPTIONAL DescriptorSelect;
	VersionId : OPTIONAL IdentifierSelect;
	StockMaterialType : StockCategoryEnum;
	PropertyValues : SET[1:?] OF MaterialPropertyValue;
	ReferenceDirection : OPTIONAL Direction;
END_ENTITY;

ENTITY StringValue
	SUBTYPE OF(PropertyValue);
	ValueComponent : MultiLingualStringSelect;
END_ENTITY;

ENTITY StyledModel
	SUBTYPE OF(GeometricRepresentation);
	DefinedIn : DigitalFile;
END_ENTITY;

ENTITY SubEdge
	SUBTYPE OF(Edge);
	ParentEdge : Edge;
END_ENTITY;

ENTITY SubsetMember;
	Subset : ClassSelect;
	Superset : ClassSelect;
END_ENTITY;

ENTITY SuppliedObjectRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Relating : SuppliedObjectSelect;
	Related : SuppliedObjectSelect;
WHERE
WR1: TYPEOF(Relating) = TYPEOF(Related);
END_ENTITY;

ENTITY SupplierSolution
	SUBTYPE OF(AlternativeSolution);
	ProbabilityRate : OPTIONAL REAL;
	Supplier : Organization;
END_ENTITY;

ENTITY Surface
	SUPERTYPE OF (ONEOF(OrientedSurface, RectangularTrimmedSurface))
	SUBTYPE OF(DetailedGeometricModelItem);
	SELF\RepresentationItem.External : ExternalItem;
END_ENTITY;

ENTITY SurfaceCondition;
	Id : IdentifierSelect;
	ConditionType : ClassString;
	AssignedTo : AssignedShapePropertySelect;
	DefinedIn : DigitalFile;
END_ENTITY;

ENTITY SurfaceCurve
	SUBTYPE OF(Curve);
END_ENTITY;

ENTITY SurfaceWithDirection;
	DefiningSurface : Surface;
	MaterialDirection : Direction;
END_ENTITY;

ENTITY SystemBreakdown
	SUBTYPE OF(Breakdown);
DERIVE
	SELF\Breakdown.BreakdownType : STRING := 'system';
END_ENTITY;

ENTITY TechnicalSolution
	SUBTYPE OF(AlternativeSolution);
END_ENTITY;

ENTITY ThicknessLaminateTable
	SUBTYPE OF(ZoneStructuralMakeup);
	TableComponents : LIST[2:?] OF ThicknessLaminateTableComponentSelect;
END_ENTITY;

ENTITY ThicknessSizeDimension;
	Id : IdentifierSelect;
	AppliedTo : ShapeElement;
	Thickness : NumericalValue;
END_ENTITY;

ENTITY ThreeDGeometrySet
	SUBTYPE OF(ConstituentShapeRepresentation);
	BasisRole : ClassSelect;
	BasisSurface : Surface;
	DefiningBoundary : SET[1:?] OF Curve;
	ThreeDGeometry : ExternalGeometricModel;
END_ENTITY;

ENTITY TimeInterval
	SUPERTYPE OF (ONEOF(TimeIntervalWithBounds, TimeIntervalWithId));
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
END_ENTITY;

ENTITY TimeIntervalAssignment;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : ClassSelect;
	AssignedTimeInterval : TimeInterval;
	AssignedTo : GeneralOrganizationalDataSelect;
END_ENTITY;

ENTITY TimeIntervalEffectivity
	SUBTYPE OF(DatedEffectivity);
	EffectivityPeriod : Duration;
WHERE
WR1: EXISTS(SELF\DatedEffectivity.StartDefinition) OR EXISTS(SELF\DatedEffectivity.EndDefinition);
END_ENTITY;

ENTITY TimeIntervalRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : TimeInterval;
	Related : TimeInterval;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY TimeIntervalWithBounds
	SUBTYPE OF(TimeInterval);
	Duration : OPTIONAL Duration;
	PrimaryBound : OPTIONAL EventOrDateSelect;
	SecondaryBound : OPTIONAL EventOrDateSelect;
WHERE
WR1: NOT (EXISTS (SecondaryBound) AND EXISTS (Duration));
WR2: EXISTS (PrimaryBound) OR EXISTS (SecondaryBound);
END_ENTITY;

ENTITY TimeIntervalWithId
	SUBTYPE OF(TimeInterval);
	SELF\TimeInterval.Id : IdentifierSelect;
END_ENTITY;

ENTITY ToolAttachmentPointFrame
	SUBTYPE OF(AxisPlacement);
END_ENTITY;

ENTITY ToolCentrePointFrame
	SUBTYPE OF(AxisPlacement);
END_ENTITY;

ENTITY ToolPartRelationship
	SUBTYPE OF(PartViewRelationship);
	Placement : OPTIONAL TransformationSelect;
DERIVE
	SELF\PartViewRelationship.RelationType : STRING := 'tool part';
WHERE
WR1: NOT ('GEOMETRICREPRESENTATIONRELATIONSHIPWITHPLACEMENTTRANSFORMATION' IN TYPEOF(Placement)) OR (Placement.Definitional = FALSE);
END_ENTITY;

ENTITY TopologicalRepresentationItem
	ABSTRACT
	SUPERTYPE OF (ONEOF(ConnectedEdgeSet, Edge, Path, Vertex))
	SUBTYPE OF(RepresentationItem);
END_ENTITY;

ENTITY TopologyToGeometryAssociationByMultipleElementPairs
	SUBTYPE OF(RepresentationRelationship);
	Origin : SET[1:?] OF TopologyGeometryAssociationTopologicalItemsSelect;
	Target : SET[1:?] OF TopologyGeometryAssociationGeometricItemsSelect;
END_ENTITY;

ENTITY TransformedGeometricModel
	SUBTYPE OF(GeometricModel);
	SELF\Representation.Items : SET[1:?] OF AxisPlacement;
INVERSE
	DerivedFrom : GeometricRepresentationRelationship FOR Related;
WHERE
WR1: (SCHEMA_NAME + 'GEOMETRICREPRESENTATIONRELATIONSHIPWITHOPERATORTRANSFORMATION' IN TYPEOF(DerivedFrom)) OR  (SCHEMA_NAME + 'GEOMETRICREPRESENTATIONRELATIONSHIPWITHPLACEMENTTRANSFORMATION' IN TYPEOF(DerivedFrom));
END_ENTITY;

ENTITY TrimmedCurve
	SUBTYPE OF(Curve);
END_ENTITY;

ENTITY TwistedCrossSectionalGroupShapeElement
	SUBTYPE OF(CrossSectionalGroupShapeElement);
	TwistDirection : OPTIONAL TwistDirectionEnum;
	TwistPeriod : OPTIONAL ValueWithUnit;
END_ENTITY;

ENTITY UncertaintyQualifier
	SUPERTYPE OF (ONEOF(QualitativeUncertainty, StandardUncertainty));
	Description : OPTIONAL DescriptorSelect;
	MeasureName : MultiLingualStringSelect;
	SameAs : OPTIONAL Proxy;
END_ENTITY;

ENTITY Unit;
	Name : ClassSelect;
	Kind : OPTIONAL ClassSelect;
	Prefix : OPTIONAL ClassSelect;
	Quantity : OPTIONAL ClassSelect;
END_ENTITY;

ENTITY UserDefined11
	SUBTYPE OF(RepresentationItem);
	Definition : CharacterString;
END_ENTITY;

ENTITY Validation;
	Id : IdentifierSelect;
	Description : DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
	ValidatedBy : OPTIONAL SET[1:?] OF Evidence;
	Validates : ValidationSelect;
END_ENTITY;

ENTITY ValueLimit
	SUBTYPE OF(NumericalValue);
	Qualifier : TypeQualifierSelect;
END_ENTITY;

ENTITY ValueList
	SUBTYPE OF(PropertyValue);
	Values : LIST[1:?] OF PropertyValue;
END_ENTITY;

ENTITY ValueRange
	SUBTYPE OF(ValueWithUnit);
	LowerLimit : REAL;
	UpperLimit : REAL;
END_ENTITY;

ENTITY ValueSet
	SUBTYPE OF(PropertyValue);
	Values : SET[1:?] OF PropertyValue;
END_ENTITY;

ENTITY ValueWithTolerances
	SUBTYPE OF(ValueWithUnit);
	LowerLimit : REAL;
	TolerancedValue : REAL;
	UpperLimit : REAL;
END_ENTITY;

ENTITY ValueWithUnit
	ABSTRACT
	SUPERTYPE OF (ONEOF(NumericalValue, ValueRange, ValueWithTolerances))
	SUBTYPE OF(PropertyValue);
	SignificantDigits : OPTIONAL INTEGER;
	Unit : UnitSelect;
END_ENTITY;

ENTITY Verification;
	Id : IdentifierSelect;
	Description : DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
	VerifiedBy : OPTIONAL SET[1:?] OF Evidence;
	Verifies : RequirementSatisfactionAssertion;
END_ENTITY;

ENTITY VerificationRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : OPTIONAL ClassSelect;
	Relating : Verification;
	Related : Verification;
END_ENTITY;

ENTITY Vertex
	SUPERTYPE OF (VertexOnEdge)
	SUBTYPE OF(TopologicalRepresentationItem);
END_ENTITY;

ENTITY VertexOnEdge
	SUBTYPE OF(Vertex);
	DistanceFromStartOrEnd : PositiveLengthMeasure;
	MeasureFromStartOrEnd : BOOLEAN;
	ParentEdge : EdgeWithLength;
WHERE
WR1 : self.DistanceFromStartOrEnd < self.ParentEdge.EdgeLength;
END_ENTITY;

ENTITY VertexPoint
	SUBTYPE OF(DetailedGeometricModelItem);
	SELF\RepresentationItem.External : ExternalItem;
END_ENTITY;

ENTITY ViewContext;
	Description : OPTIONAL DescriptorSelect;
	ApplicationDomain : ApplicationDomainSelect;
	LifeCycleStage : LifeCycleStageSelect;
INVERSE
	AdditionalView : SET[0:?] OF PartView FOR AdditionalContexts;
	InitialView : SET[1:?] OF PartView FOR InitialContext;
UNIQUE
UR1: ApplicationDomain, LifeCycleStage;
END_ENTITY;

ENTITY ViewOccurrenceRelationship
	SUPERTYPE OF (ONEOF(AssemblyOccurrenceRelationship, CollectedPartRelationship));
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : PartView;
	Related : DefinitionBasedOccurrence;
END_ENTITY;

ENTITY WireColourBasedIdentificationCode
	SUBTYPE OF(PropertyDefinition);
END_ENTITY;

ENTITY WireIdentification
	SUBTYPE OF(OccurrenceTransportFeature);
	Code : OPTIONAL WireColourBasedIdentificationCode;
END_ENTITY;

ENTITY WireOccurrence
	SUBTYPE OF(QuantifiedOccurrence);
END_ENTITY;

ENTITY WireOccurrenceTerminal
	SUBTYPE OF(OccurrenceTerminal);
	SELF\OccurrenceTerminal.AssociatedTransportFeature : WireIdentification;
	SELF\ShapeElement.ElementOf : WireOccurrence;
END_ENTITY;

ENTITY WiringHarnessAssemblyDesign
	SUBTYPE OF(AssemblyDefinition);
	Topology : OPTIONAL ConnectedEdgeWithLengthSetRepresentation;
END_ENTITY;

ENTITY WorkOrder;
	Id : IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	VersionId : OPTIONAL IdentifierSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	InResponseTo : OPTIONAL SET[1:?] OF WorkRequest;
	OrderType : ClassSelect;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
END_ENTITY;

ENTITY WorkOrderAssignment;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : ClassSelect;
	AssignedTo : WorkOrderAssignmentSelect;
	AssignedWorkOrder : WorkOrder;
END_ENTITY;

ENTITY WorkOrderRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : WorkOrder;
	Related : WorkOrder;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY WorkRequest;
	Id : IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	VersionId : OPTIONAL IdentifierSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RequestType : ClassSelect;
	NotifiedPersons : OPTIONAL SET[1:?] OF DateAndPersonOrganization;
	Requestor : DateAndPersonOrganization;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
	Scope : OPTIONAL SET[1:?] OF ActivityAssignmentSelect;
	Status : OPTIONAL ClassSelect;
END_ENTITY;

ENTITY WorkRequestAssignment;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : ClassSelect;
	AssignedTo : WorkRequestAssignmentSelect;
	AssignedWorkRequest : WorkRequest;
END_ENTITY;

ENTITY WorkRequestRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : WorkRequest;
	Related : WorkRequest;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY ZonalBreakdown
	SUBTYPE OF(Breakdown);
DERIVE
	SELF\Breakdown.BreakdownType : STRING := 'zonal';
END_ENTITY;

ENTITY ZoneStructuralMakeup
	ABSTRACT
	SUPERTYPE OF (ONEOF(PercentageLaminateTable, SmearedMaterial, ThicknessLaminateTable))
	SUBTYPE OF(LaminateTable);
	Boundary : ZoneStructuralMakeupShapeRepresentation;
END_ENTITY;

ENTITY ZoneStructuralMakeupShapeRepresentation
	SUPERTYPE OF (ONEOF(EdgeZoneShape, PointZoneShape));
END_ENTITY;

END_SCHEMA;