END_ENTITY;

ENTITY MaterialPropertyAssignment;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : ClassSelect;
	AssignedProperty : MaterialPropertyValue;
	AssignedTo : MaterialIdentification;
	Definitional : OPTIONAL BOOLEAN;
END_ENTITY;

ENTITY MaterialPropertyDefinition
	SUBTYPE OF(PropertyDefinition);
	Name : DescriptorSelect;
END_ENTITY;

ENTITY MaterialPropertyValue;
	Definition : MaterialPropertyDefinition;
	EnvironmentCondition : DataEnvironment;
	MaterialValue : PropertyValue;
END_ENTITY;

ENTITY MatingDefinition
	SUBTYPE OF(AssemblyDefinition);
	MatingType : OPTIONAL ClassSelect;
INVERSE
	MatedParts : SET[2:?] OF MatedPartAssociation FOR Relating;
END_ENTITY;

ENTITY MeasureQualification;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Qualifiers : SET[1:?] OF ValueQualifierSelect;
END_ENTITY;

ENTITY MeasuredCharacteristic;
	Id : IdentifierSelect;
	Name : OPTIONAL DescriptorSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	MeasureActivity : OPTIONAL MeasureActivitySelect;
	MeasuredCharacteristics : OPTIONAL SET[1:?] OF PropertyValueAssignment;
END_ENTITY;

ENTITY Mechanism
	SUBTYPE OF(GeometricRepresentation);
	SELF\Representation.Items : SET[1:?] OF KinematicPair;
END_ENTITY;

ENTITY MechanismState
	SUBTYPE OF(GeometricRepresentation);
	SELF\Representation.Items : SET[1:?] OF KinematicPairValue;
	RepresentedMechanism : Mechanism;
END_ENTITY;

ENTITY Message;
	Id : IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Contains : OPTIONAL SET[1:?] OF MessageContentSelect;
	DefinedBy : OPTIONAL SET[1:?] OF MessageDefinerSelect;
	ExchangeContext : OPTIONAL SET[1:?] OF ExchangeContext;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
END_ENTITY;

ENTITY MessageRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : OPTIONAL ClassSelect;
	Relating : Message;
	Related : Message;
END_ENTITY;

ENTITY ModelProperty;
	Definition : PropertyDefinitionSelect;
	SpecifiedValue : ModelPropertyValueSelect;
END_ENTITY;

ENTITY ModelPropertyAssignment;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : OPTIONAL ClassSelect;
	AssignedProperty : ModelProperty;
	AssignedTo : PropertyAssignmentSelect;
	ValidityContext : OPTIONAL ValidityContextSelect;
END_ENTITY;

ENTITY ModifyElement
	SUBTYPE OF(DeltaChangeActivity);
	CurrentDesignObject : SET[1:?] OF DeltaChangeManagementObjectSelect;
END_ENTITY;

ENTITY ModifySingleElement
	SUBTYPE OF(DeltaChangeActivity);
	CurrentDesignObject : DeltaChangeManagementObjectSelect;
	PreviousDesignObject : DeltaChangeManagementObjectSelect;
WHERE
WR1: CurrentDesignObject :<>: PreviousDesignObject;
END_ENTITY;

ENTITY MomentsOfInertia
	SUBTYPE OF(ShapeDependentProperty);
	SELF\ShapeDependentProperty.DefinedIn : GeometricCoordinateSpace;
	InertiaValue : ARRAY[1:3] OF ARRAY[1:3] OF NumericalValue;
	ReferenceAxisPlacement : AxisPlacement;
END_ENTITY;

ENTITY MotionModelAssociation;
	AssociatedModel : MotionModelSelect;
	AssociatedTo : AssemblyDefinition;
END_ENTITY;

ENTITY NamedSize
	SUBTYPE OF(RectangularSize);
	Size : ClassSelect;
END_ENTITY;

ENTITY NextAssemblyOccurrenceUsage
	SUPERTYPE OF (MatedPartAssociation)
	SUBTYPE OF(AssemblyOccurrenceRelationship);
DERIVE
	SELF\ViewOccurrenceRelationship.RelationType : STRING := 'next assembly occurrence';
END_ENTITY;

ENTITY NextAssemblyViewUsage
	SUBTYPE OF(AssemblyViewRelationship);
DERIVE
	SELF\PartViewRelationship.RelationType : STRING := 'next assembly view';
END_ENTITY;

ENTITY NextInstanceForward
	SUBTYPE OF(ExternalEntityInstance);
	AttributeName : STRING;
	NextInstance : ExternalEntityInstance;
END_ENTITY;

ENTITY NextInstanceInverse
	SUBTYPE OF(ExternalEntityInstance);
	AttributeName : STRING;
	NextInstance : ExternalEntityInstance;
END_ENTITY;

ENTITY NotCondition
	SUBTYPE OF(Condition);
DERIVE
	SELF\Condition.ConditionType : STRING := 'not';
END_ENTITY;

ENTITY NotEqualsCondition
	SUBTYPE OF(Condition);
DERIVE
	SELF\Condition.ConditionType : STRING := 'not equals';
END_ENTITY;

ENTITY NumericalContext;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Accuracy : REAL;
	SignificantDigits : OPTIONAL INTEGER;
END_ENTITY;

ENTITY NumericalValue
	SUPERTYPE OF (ValueLimit)
	SUBTYPE OF(ValueWithUnit);
	ValueComponent : REAL;
	ValueContext : OPTIONAL NumericalContext;
END_ENTITY;

ENTITY Occurrence
	ABSTRACT
	SUPERTYPE OF (ONEOF(DefinitionBasedOccurrence, SpecifiedOccurrence));
	Id : IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	DefiningGeometry : OPTIONAL GeometricModel;
	Definition : OccurrenceOrOccurrenceDefinitionSelect;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
END_ENTITY;

ENTITY OccurrenceContactFeature
	SUPERTYPE OF (OccurrenceTerminal)
	SUBTYPE OF(OccurrenceShapeFeature);
	SELF\OccurrenceShapeElement.Definition : OPTIONAL OccurrenceContactFeatureDefinitionSelect;
	SELF\OccurrenceShapeFeature.ElementOf : OccurrenceContactFeatureElementOfSelect;
END_ENTITY;

ENTITY OccurrencePlacement;
	PlacedInstance : SingleOccurrence;
	Placement : TransformationSelect;
	ReferenceComponent : BreakdownElementView;
WHERE
WR1: NOT ('GEOMETRICREPRESENTATIONRELATIONSHIPWITHPLACEMENTTRANSFORMATION' IN TYPEOF(Placement)) OR (Placement.Definitional = TRUE);
END_ENTITY;

ENTITY OccurrenceRelationship
	SUPERTYPE OF (ONEOF(ReplacedUsageRelationship, SameTimeMachiningRelationship));
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : Occurrence;
	Related : Occurrence;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY OccurrenceShapeElement
	SUPERTYPE OF (OccurrenceShapeFeature)
	SUBTYPE OF(ShapeElement);
	DefinitionOSE : OPTIONAL OccurrenceShapeElementDefinitionSelect;
	SELF\ShapeElement.ElementOf : OccurrenceShapeElementElementOfSelect;
END_ENTITY;

ENTITY OccurrenceShapeFeature
	SUPERTYPE OF (ONEOF(CrossSectionalOccurrenceShapeElement, OccurrenceContactFeature, OccurrenceTransportFeature))
	SUBTYPE OF(OccurrenceShapeElement);
	SELF\OccurrenceShapeElement.Definition : OPTIONAL OccurrenceShapeFeatureDefinitionSelect;
	SELF\OccurrenceShapeElement.ElementOf : OccurrenceShapeFeatureElementOfSelect;
END_ENTITY;

ENTITY OccurrenceTerminal
	SUPERTYPE OF (ONEOF(CableOccurrenceTerminal, CableOccurrenceTerminalLocationGroup, WireOccurrenceTerminal))
	SUBTYPE OF(OccurrenceContactFeature);
	AssociatedTransportFeature : OPTIONAL OccurrenceTransportFeature;
	SELF\OccurrenceContactFeature.Definition : OccurrenceTerminalDefinitionSelect;
	SELF\OccurrenceContactFeature.ElementOf : OccurrenceTerminalElementOfSelect;
END_ENTITY;

ENTITY OccurrenceTransportFeature
	SUPERTYPE OF (WireIdentification)
	SUBTYPE OF(OccurrenceShapeFeature);
	SELF\OccurrenceShapeElement.Definition : OPTIONAL OccurrenceTransportFeatureDefinitionSelect;
	DomainType : OPTIONAL TerminalAndTransportDomainTypeEnum;
	SELF\OccurrenceShapeFeature.ElementOf : OccurrenceTransportFeatureElementOfSelect;
END_ENTITY;

ENTITY OneOfCondition
	SUBTYPE OF(Condition);
DERIVE
	SELF\Condition.ConditionType : STRING := 'one of';
END_ENTITY;

ENTITY OrCondition
	SUBTYPE OF(Condition);
DERIVE
	SELF\Condition.ConditionType : STRING := 'or';
END_ENTITY;

ENTITY Organization;
	Id : IdentifierSelect;
	Name : OPTIONAL DescriptorSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	OrganizationTypes : OPTIONAL SET[1:?] OF ClassSelect;
END_ENTITY;

ENTITY OrganizationInContract;
	Description : OPTIONAL SET[1:?] OF DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	ContractedOrganization : Organization;
	OrganizationRole : ClassSelect;
	SignedBy : OPTIONAL SET[1:?] OF DateAndPersonOrganization;
	SignedContracts : SET[1:?] OF Contract;
END_ENTITY;

ENTITY OrganizationOrPersonInOrganizationAssignment;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : ClassSelect;
	AssignedPersonOrOrganization : OrganizationOrPersonInOrganizationSelect;
	AssignedTo : DateTimePersonOrganizationElementSelect;
END_ENTITY;

ENTITY OrganizationRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : Organization;
	Related : Organization;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY OrientedSurface
	SUBTYPE OF(Surface);
END_ENTITY;

ENTITY Part;
	Id : IdentifierSelect;
	Name : DescriptorSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	PartTypes : SET[1:?] OF PartClassSelect;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
	Versions : SET[1:?] OF PartVersion;
END_ENTITY;

ENTITY PartConnectivityDefinition
	SUBTYPE OF(PartShapeElement);
	ConnectedTerminals : SET[2:?] OF ConnectedTerminalSelect;
END_ENTITY;

ENTITY PartContactFeature
	SUPERTYPE OF (PartTerminal)
	SUBTYPE OF(PartFeature);
	SELF\PartShapeElement.Definition : OPTIONAL PartContactFeatureDefinitionSelect;
	SELF\PartShapeElement.ElementOf : PartContactFeatureElementOfSelect;
END_ENTITY;

ENTITY PartContactFeatureFitRelationship
	SUBTYPE OF(PartFeatureFitRelationship);
	SELF\PartShapeElementRelationship.Relating : PartContactFeature;
	SELF\PartShapeElementRelationship.Related : PartContactFeature;
	SELF\PartFeatureFitRelationship.Definition : OPTIONAL PartContactFeatureFitRelationshipDefinitionSelect;
	ParentRelationshipPCFFR : OPTIONAL PartContactFeatureFitRelationship;
END_ENTITY;

ENTITY PartFeature
	SUPERTYPE OF (ONEOF(PartContactFeature, PartTransportFeature))
	SUBTYPE OF(PartShapeElement);
END_ENTITY;

ENTITY PartFeatureFitRelationship
	SUPERTYPE OF (PartContactFeatureFitRelationship)
	SUBTYPE OF(PartShapeElementRelationship);
	SELF\PartShapeElementRelationship.Relating : PartFeature;
	SELF\PartShapeElementRelationship.Related : PartFeature;
	DefinitionPFFR : OPTIONAL PartFeatureFitRelationshipDefinitionSelect;
END_ENTITY;

ENTITY PartRelationship
	SUPERTYPE OF (AlternatePartRelationship);
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : Part;
	Related : Part;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY PartShapeElement
	SUPERTYPE OF (ONEOF(AssemblyShapeConstraint, AssemblyShapeJoint, CrossSectionalPartShapeElement, HarnessNode, HarnessSegment, PartConnectivityDefinition, PartFeature))
	SUBTYPE OF(ShapeElement);
	DefinitionPSE : OPTIONAL PartShapeElementDefinitionSelect;
	SELF\ShapeElement.ElementOf : PartShapeElementElementOfSelect;
END_ENTITY;

ENTITY PartShapeElementRelationship
	SUPERTYPE OF (PartFeatureFitRelationship)
	SUBTYPE OF(ShapeElementRelationship);
	SELF\ShapeElementRelationship.Relating : PartShapeElement;
	SELF\ShapeElementRelationship.Related : PartShapeElement;
END_ENTITY;

ENTITY PartTerminal
	SUBTYPE OF(PartContactFeature);
	AssociatedTransportFeature : OPTIONAL PartTransportFeature;
	DomainType : OPTIONAL TerminalAndTransportDomainTypeEnum;
	SELF\PartShapeElement.ElementOf : PartTerminalElementOfSelect;
	IntendedJointType : OPTIONAL SET[1:?] OF TerminalJointTypeEnum;
	InterfaceOrJoinTerminal : OPTIONAL InterfaceOrJoinTerminalEnum;
END_ENTITY;

ENTITY PartToIndividualPartAssociation;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : OPTIONAL ClassSelect;
	AssociatedIndividualPart : IndividualPart;
	AssociatedPart : Part;
END_ENTITY;

ENTITY PartTransportFeature
	SUBTYPE OF(PartFeature);
	DomainType : OPTIONAL TerminalAndTransportDomainTypeEnum;
	SELF\PartShapeElement.ElementOf : PartTransportFeatureElementOfSelect;
END_ENTITY;

ENTITY PartVersion;
	Id : IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
	Views : OPTIONAL SET[1:?] OF PartView;
INVERSE
	CorrespondingProductConfigurations : SET[0:?] OF ProductDesignAssociation FOR AssociatedDesign;
	VersionOf : Part FOR Versions;
END_ENTITY;

ENTITY PartVersionRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : PartVersion;
	Related : PartVersion;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY PartVersionToIndividualPartVersionAssociation;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : OPTIONAL ClassSelect;
	AssociatedIndividualPart : IndividualPartVersion;
	AssociatedPart : PartVersionOrProductConfigurationSelect;
END_ENTITY;

ENTITY PartView
	SUPERTYPE OF (ONEOF(AssemblyDefinition, CollectionDefinition, ConstituentPart, LaminateTable));
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	AdditionalContexts : OPTIONAL SET[1:?] OF ViewContext;
	AuxiliaryGeometry : OPTIONAL SET[1:?] OF GeometricModel;
	DefiningGeometry : OPTIONAL GeometricModel;
	InitialContext : ViewContext;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
INVERSE
	ViewOf : PartVersion FOR Views;
WHERE
WR1: NOT (EXISTS(AuxiliaryGeometry)) OR EXISTS(DefiningGeometry);
END_ENTITY;

ENTITY PartViewRelationship
	SUPERTYPE OF (ONEOF(AssemblyViewRelationship, DefinitionalPartViewUsage, GeometricalRelationship, MakeFromRelationship, ProcessStateRelationship, ReplacedPartViewRelationship, ToolPartRelationship));
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : PartView;
	Related : PartView;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY PartViewToIndividualPartViewAssociation;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : OPTIONAL ClassSelect;
	AssociatedIndividualPart : IndividualPartView;
	AssociatedPart : PartViewOrProductConfigurationSelect;
END_ENTITY;

ENTITY Path
	SUBTYPE OF(TopologicalRepresentationItem);
	EdgeList : SET[1:?] OF Edge;
	OrientationList : SET[1:?] OF BOOLEAN;
END_ENTITY;

ENTITY PathSegment
	ABSTRACT
	SUPERTYPE OF (ONEOF(CircularPath, LinearPath, PointToPointPath));
	PlacementEnd : AxisPlacement;
	TEnd : REAL;
	Transition : TransitionCodeEnum;
END_ENTITY;

ENTITY Pcurve
	SUBTYPE OF(Curve);
END_ENTITY;

ENTITY PercentageLaminateTable
	SUBTYPE OF(ZoneStructuralMakeup);
	TableComponents : SET[1:?] OF PercentagePly;
	TotalThickness : NumericalValue;
END_ENTITY;

ENTITY PercentagePly;
	MakeupAndProperties : OPTIONAL ZoneStructuralMakeup;
	Material : StockMaterial;
	StrengthOrientation : OPTIONAL PlyOrientationAngle;
	VolumePercent : NumericalValue;
END_ENTITY;

ENTITY Person;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	FirstName : OPTIONAL STRING;
	LastName : STRING;
	MiddleNames : OPTIONAL LIST[1:?] OF STRING;
	PrefixTitles : OPTIONAL LIST[1:?] OF STRING;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
	SuffixTitles : OPTIONAL LIST[1:?] OF STRING;
INVERSE
	AssociatedOrganizations : SET[1:?] OF PersonInOrganization FOR AssociatedPerson;
END_ENTITY;

ENTITY PersonInOrganization;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	AssociatedOrganization : Organization;
	AssociatedPerson : Person;
	PersonRole : ClassSelect;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
END_ENTITY;

ENTITY PersonInOrganizationRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : PersonInOrganization;
	Related : PersonInOrganization;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY PhysicalBreakdown
	SUBTYPE OF(Breakdown);
DERIVE
	SELF\Breakdown.BreakdownType : STRING := 'physical';
END_ENTITY;

ENTITY PhysicalDocumentDefinition
	SUBTYPE OF(DocumentDefinition);
	Components : OPTIONAL SET[1:?] OF Hardcopy;
END_ENTITY;

ENTITY PlannedActivity
	SUPERTYPE OF (DirectedPlannedActivity)
	SUBTYPE OF(Activity);
	VersionId : OPTIONAL IdentifierSelect;
	PlannedEndDate : OPTIONAL PeriodOrDateSelect;
	PlannedStartDate : OPTIONAL EventOrDateSelect;
END_ENTITY;

ENTITY PlannedCharacteristic;
	Name : OPTIONAL DescriptorSelect;
	DefinedFor : RequirementAssignment;
	PlannedCharacteristics : OPTIONAL SET[1:?] OF PropertyValueAssignment;
END_ENTITY;

ENTITY PlannedIndividualPart
	SUBTYPE OF(IndividualPartVersion);
END_ENTITY;

ENTITY Ply
	SUBTYPE OF(ConstituentPart);
	Constituents : OPTIONAL LIST[1:?] OF PlyPiece;
	MaterialOrientation : PlyOrientationAngle;
	MaterialType : StockMaterial;
	PlyThickness : NumericalValue;
	PlyShape : OPTIONAL PlyShape;
WHERE
WR1 : SELF.PlyThickness.ValueComponent >= 0.0;
WR2 : SELF.PlyThickness.Unit.Name='length';
END_ENTITY;

ENTITY PlyAngleRepresentation
	SUBTYPE OF(Representation);
	SELF\Representation.Items : SET[1:1] OF RepresentationItem;
END_ENTITY;

ENTITY PlyLaminate
	SUBTYPE OF(ConstituentPart);
	PlyTable : PlyLaminateTable;
	PlyLaminateShape : OPTIONAL PlyLaminateShapeSelect;
END_ENTITY;

ENTITY PlyLaminateSequenceDefinition
	SUBTYPE OF(ConstituentPart);
	PliesInSequence : SET[1:?] OF Ply;
END_ENTITY;

ENTITY PlyLaminateTable
	SUBTYPE OF(LaminateTable);
	Sequence : LIST[2:?] OF PlyLaminateSequenceDefinition;
END_ENTITY;

ENTITY PlyOrientationAngle
	ABSTRACT
	SUPERTYPE OF (ONEOF(DrapedOrientationAngle, LaidOrientationAngle))
	SUBTYPE OF(RepresentationRelationship);
	SELF\RepresentationRelationship.Relating : PlyAngleRepresentation;
	SELF\RepresentationRelationship.Related : ReinforcementOrientationBasis;
DERIVE
	FiberDirection : PlyAngleRepresentation := SELF\RepresentationRelationship.Relating;
	ReinforcementDirection : ReinforcementOrientationBasis := SELF\RepresentationRelationship.Related;
END_ENTITY;

ENTITY PlyPiece
	SUBTYPE OF(ConstituentPart);
	PlyPieceShape : OPTIONAL PlyShape;
	WarpSurface : LOGICAL;
END_ENTITY;

ENTITY PlyShape;
	Basis : OPTIONAL PlyShape;
	DefiningModel : PlyLaminateShapeSelect;
END_ENTITY;

ENTITY Point
	ABSTRACT
	SUPERTYPE OF (ONEOF(CartesianPoint, DegeneratePcurve, PointOnCurve, PointOnSurface))
	SUBTYPE OF(DetailedGeometricModelItem);
END_ENTITY;

ENTITY PointAndVector
	SUBTYPE OF(DetailedGeometricModelItem);
	Location : Point;
	Vector : SET[1:2] OF Direction;
END_ENTITY;

ENTITY PointArray
	SUBTYPE OF(DetailedGeometricModelItem);
	Directions : SET[1:?] OF PointAndVector;
END_ENTITY;

ENTITY PointOnCurve
	SUBTYPE OF(Point);
	BasicCurve : Curve;
	SELF\RepresentationItem.External : ExternalItem;
	Parameter : ExternalRepresentationItem;
END_ENTITY;

ENTITY PointOnSurface
	SUBTYPE OF(Point);
	BasicSurface : Surface;
	SELF\RepresentationItem.External : ExternalItem;
	Parameter : ExternalRepresentationItem;
END_ENTITY;

ENTITY PointToPointPath
	SUBTYPE OF(PathSegment);
END_ENTITY;

ENTITY PointZoneShape
	SUBTYPE OF(ZoneStructuralMakeupShapeRepresentation);
	Location : PointSelect;
END_ENTITY;

ENTITY Polar11
	SUBTYPE OF(DetailedGeometricModelItem);
	Placement : AxisPlacement;
END_ENTITY;

ENTITY PreDefinedTypeQualifier;
	Name : ClassSelect;
END_ENTITY;

ENTITY PrecisionQualifier;
	SameAs : OPTIONAL Proxy;
	SignificantDigits : INTEGER;
END_ENTITY;

ENTITY ProcessOperationDefinition;
	Id : IdentifierSelect;
	Name : OPTIONAL DescriptorSelect;
	Description : OPTIONAL DescriptorSelect;
	VersionId : OPTIONAL IdentifierSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	ProcessType : ClassSelect;
END_ENTITY;

ENTITY ProcessOperationDefinitionRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : ProcessOperationDefinition;
	Related : ProcessOperationDefinition;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY ProcessOperationInputOrOutput;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : ClassSelect;
	ConcernedShapes : OPTIONAL SET[1:?] OF ShapeElement;
	Element : ProcessOperationInputOrOutputSelect;
	Operation : ProcessOperationOccurrence;
	Placement : OPTIONAL GeometricRepresentationRelationshipWithPlacementTransformation;
END_ENTITY;

ENTITY ProcessOperationOccurrence;
	Id : IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	DefinedIn : OPTIONAL GeometricCoordinateSpace;
	Definition : ProcessOperationDefinition;
	Plan : ProcessPlan;
END_ENTITY;

ENTITY ProcessOperationOccurrenceRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : ProcessOperationOccurrence;
	Related : ProcessOperationOccurrence;
	CycleTime : OPTIONAL Duration;
	WaitingTime : OPTIONAL PropertyValue;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY ProcessOperationResourceAssignment;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	AssignedResource : ProcessOperationResourceAssignmentSelect;
	AssignedTo : ProcessOperationOccurrence;
	Placement : OPTIONAL GeometricRepresentationRelationshipWithPlacementTransformation;
	Reason : OPTIONAL MultiLingualStringSelect;
	ReferenceTool : BOOLEAN;
END_ENTITY;

ENTITY ProcessPlan;
	Id : IdentifierSelect;
	Name : OPTIONAL DescriptorSelect;
	Description : OPTIONAL DescriptorSelect;
	VersionId : OPTIONAL IdentifierSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	ProducedOutputs : OPTIONAL SET[1:?] OF PartVersion;
END_ENTITY;

ENTITY ProcessPlanRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : ProcessPlan;
	Related : ProcessPlan;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY ProcessStateRelationship
	SUBTYPE OF(PartViewRelationship);
DERIVE
	SELF\PartViewRelationship.RelationType : STRING := 'process state';
END_ENTITY;

ENTITY ProcessedCore
	SUBTYPE OF(ConstituentPart);
	AddedMaterial : OPTIONAL LIST[1:?] OF Ply;
	CellDirection : PlyOrientationAngle;
	MadeFromProcessedCore : OPTIONAL SET[1:?] OF ProcessedCore;
	MadeFromStock : StockMaterial;
	ProcessedCoreShape : OPTIONAL CoreShapeSelect;
WHERE
WR1: SELF.MadeFromStock.StockMaterialType = stock_core;
END_ENTITY;

ENTITY ProductClass
	SUBTYPE OF(ProductConcept);
	VersionId : OPTIONAL IdentifierSelect;
	LevelType : OPTIONAL ClassSelect;
END_ENTITY;

ENTITY ProductClassRelationship;
	Id : OPTIONAL IdentifierSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	RelationType : ClassSelect;
	Relating : ProductClass;
	Related : ProductClass;
WHERE
	WR1: Relating :<>: Related;
END_ENTITY;

ENTITY ProductConcept
	SUPERTYPE OF (ProductClass);
	Id : IdentifierSelect;
	Name : OPTIONAL DescriptorSelect;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
	TargetMarket : OPTIONAL Market;
END_ENTITY;

ENTITY ProductConfiguration;
	Id : IdentifierSelect;
	Name : OPTIONAL DescriptorSelect;
	Description : OPTIONAL DescriptorSelect;
	VersionId : OPTIONAL IdentifierSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	DefiningGeometry : OPTIONAL GeometricModel;
	DefiningSpecifications : OPTIONAL SET[1:?] OF Specification;
	MemberOf : ProductConcept;
	SameAs : OPTIONAL SET[1:?] OF Proxy;
INVERSE
	CorrespondingPartVersion : SET[0:1] OF ProductDesignAssociation FOR AssociatedConfiguration;
END_ENTITY;

