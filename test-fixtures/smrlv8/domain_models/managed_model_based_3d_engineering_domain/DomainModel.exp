ENTITY FunctionalBreakdown
	SUBTYPE OF(Breakdown);
DERIVE
	SELF\Breakdown.BreakdownType : STRING := 'functional';
END_ENTITY;

ENTITY FunctionalBreakdownElementViewAssociation;
	Description : OPTIONAL DescriptorSelect;
	ClassifiedAs : OPTIONAL SET[1:?] OF Classification;
	Role : ClassSelect;
	AssociatedFunctionalElement : BreakdownElementView;
	AssociatedPhysicalElement : PhysicalElementSelect;
END_ENTITY;

ENTITY GeneralGeometricRepresentationRelationship
	SUBTYPE OF(GeometricRepresentationRelationship);
	RelationType : ClassSelect;
END_ENTITY;

ENTITY GeneralShapeDependentProperty
	SUBTYPE OF(ShapeDependentProperty);
	PropertyType : PropertyDefinitionSelect;
	PropertyValue : PropertyValueSelect;
	Unit : OPTIONAL Unit;
END_ENTITY;

ENTITY GeometricCoordinateSpace
	SUBTYPE OF(RepresentationContext);
	DimensionCount : INTEGER;
	SELF\RepresentationContext.Representations : OPTIONAL SET[1:?] OF GeometricRepresentation;
WHERE
WR1: DimensionCount > 0;
END_ENTITY;

ENTITY GeometricCurveSet
	SUPERTYPE OF (BoundaryCurveSet)
	SUBTYPE OF(GeometricSet);
	SELF\GeometricSet.Elements : SET[1:?] OF CurveOrPointSelect;
END_ENTITY;

ENTITY GeometricModel
	SUPERTYPE OF (ONEOF(ComposedGeometricModel, ExternalGeometricModel, TransformedGeometricModel))
	SUBTYPE OF(GeometricRepresentation);
	ModelExtent : OPTIONAL LengthMeasure;
END_ENTITY;

ENTITY GeometricRepresentation
	ABSTRACT
	SUPERTYPE OF (ONEOF(ConstituentShapeRepresentation, GeometricModel, InterpolatedConfigurationModel, KinematicLink, LinkMotionAlongPath, Mechanism, MechanismState, StyledModel))
	SUBTYPE OF(Representation);
INVERSE
	SELF\Representation.ContextOfItems : GeometricCoordinateSpace FOR Representations;
END_ENTITY;

ENTITY GeometricRepresentationRelationship
	ABSTRACT
	SUPERTYPE OF (ONEOF(GeneralGeometricRepresentationRelationship, GeometricRepresentationRelationshipWithCartesianTransformation, GeometricRepresentationRelationshipWithPlacementTransformation, GeometricRepresentationRelationshipWithSameCoordinateSpace))
	SUBTYPE OF(RepresentationRelationship);
	SELF\RepresentationRelationship.Relating : GeometricRepresentationSelect;
	SELF\RepresentationRelationship.Related : GeometricRepresentationSelect;
END_ENTITY;

ENTITY GeometricRepresentationRelationshipWithCartesianTransformation
	SUBTYPE OF(GeometricRepresentationRelationship);
	Transformation : CartesianTransformation;
WHERE
WR1: SELF\GeometricRepresentationRelationship.Relating.ContextOfItems :<>: SELF\GeometricRepresentationRelationship.Related.ContextOfItems;
END_ENTITY;

ENTITY GeometricRepresentationRelationshipWithPlacementTransformation
	SUBTYPE OF(GeometricRepresentationRelationship);
	Origin : AxisPlacement;
	Target : AxisPlacement;
WHERE
WR1: SELF\GeometricRepresentationRelationship.Relating.ContextOfItems :<>: SELF\GeometricRepresentationRelationship.Related.ContextOfItems;
END_ENTITY;

ENTITY GeometricRepresentationRelationshipWithSameCoordinateSpace
	SUBTYPE OF(GeometricRepresentationRelationship);
DERIVE
	SELF\RepresentationRelationship.Definitional : BOOLEAN := TRUE;
WHERE
WR1: SELF\RepresentationRelationship.Relating.ContextOfItems :=: SELF\RepresentationRelationship.Related.ContextOfItems;
END_ENTITY;

ENTITY GeometricSet
	SUPERTYPE OF (GeometricCurveSet)
	SUBTYPE OF(DetailedGeometricModelItem);
	Elements : SET[1:?] OF GeometricSetSelect;
END_ENTITY;

ENTITY GeometricSheetRepresentation
	SUBTYPE OF(CompositeSheetRepresentation);
	BasisSurface : Surface;
	Cutouts : OPTIONAL SET[1:?] OF BoundaryCurveSet;
	OuterEdge : BoundaryCurveSet;
END_ENTITY;

ENTITY GeometricalRelationship
	SUBTYPE OF(PartViewRelationship);
	Placement : GeometricRepresentationRelationshipWithPlacementTransformation;
DERIVE
	SELF\PartViewRelationship.RelationType : STRING := 'geometrically related part view';
END_ENTITY;

ENTITY GeometryToTopologyRepresentationAssociation
	SUBTYPE OF(RepresentationRelationship);
	Origin : TopologyGeometryAssociationGeometricItemsSelect;
	Target : TopologyGeometryAssociationTopologicalItemsSelect;
