 ENTITY Repositioned_tessellated_item
     SUBTYPE OF(Tessellated_item);
     location: Axis_placement_3d;
 WHERE  
   WR1: NOT (SIZEOF (['PART_AND_ZONE_LAMINATE_TABLES_ARM_LF.TESSELLATED_CURVE_SET',
                    'PART_AND_ZONE_LAMINATE_TABLES_ARM_LF.TESSELLATED_GEOMETRIC_SET',
                    'PART_AND_ZONE_LAMINATE_TABLES_ARM_LF.TESSELLATED_POINT_SET',
                    'PART_AND_ZONE_LAMINATE_TABLES_ARM_LF.TESSELLATED_SURFACE_SET',
                    'PART_AND_ZONE_LAMINATE_TABLES_ARM_LF.TESSELLATED_SHELL',
                    'PART_AND_ZONE_LAMINATE_TABLES_ARM_LF.TESSELLATED_SOLID',                
                    'PART_AND_ZONE_LAMINATE_TABLES_ARM_LF.TESSELLATED_WIRE'] * TYPEOF(SELF)) = 0);
 END_ENTITY; 
