WHERE
  WR1: SIZEOF(QUERY(pvr <* QUERY ( r <* USEDIN(SELF, 'PART_AND_ZONE_LAMINATE_TABLES_ARM_LF.REPRESENTATION.ITEMS')| 'PART_AND_ZONE_LAMINATE_TABLES_ARM_LF.PROPERTY_VALUE_REPRESENTATION' IN TYPEOF(r)) | EXISTS(pvr.context_of_items.units) )) > 0;
END_ENTITY;
(* USED FROM (Appearance_assignment_arm); *)
  ENTITY Styled_model
     ABSTRACT SUPERTYPE
  SUBTYPE OF (Representation);
